# Скопируйте в backend/.env.production и заполните реальными значениями.
# Этот файл не коммитится в git — .env* уже в .gitignore.

# Строка подключения к MongoDB. При self-hosted Mongo из docker-compose.yml
# (сервис "restocontrol-mongo" с логином/паролем) — оставьте как есть, только
# поставьте свой пароль (он же MONGO_ROOT_PASSWORD в .env.production в корне
# проекта). Имя хоста НЕ "mongo" — на VPS с несколькими проектами в общей
# docker-сети это имя уже занято чужим контейнером и резолвится не туда.
MONGO_URL=mongodb://resto:CHANGE_ME_MONGO_PASSWORD@restocontrol-mongo:27017/?authSource=admin
DB_NAME=resto_control

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_-hex_32

CORS_ORIGINS=https://restocontrol.by

# Первый менеджер, под которым вы зайдёте после деплоя и заведёте остальных
# сотрудников через админку. Смените пароль сразу после первого входа.
ADMIN_EMAIL=admin@restocontrol.by
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
