# Скопируйте в backend/.env.production и заполните реальными значениями.
# Этот файл не коммитится в git — .env* уже в .gitignore.

# Строка подключения к MongoDB. При self-hosted Mongo из docker-compose.yml
# (сервис "mongo" с логином/паролем) — оставьте как есть, только поставьте
# свой пароль (он же MONGO_ROOT_PASSWORD в .env.production в корне проекта).
MONGO_URL=mongodb://resto:CHANGE_ME_MONGO_PASSWORD@mongo:27017/?authSource=admin
DB_NAME=resto_control

# Сгенерировать: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_RUN_openssl_rand_-hex_32

# Реальный домен, без завершающего слэша. Если фронт и бэк на одном домене
# (стандартная схема из docker-compose.yml — Caddy проксирует /api на backend),
# достаточно одного значения.
CORS_ORIGINS=https://your-domain.example

# Первый менеджер, под которым вы зайдёте после деплоя и заведёте остальных
# сотрудников через админку. Смените пароль сразу после первого входа.
ADMIN_EMAIL=admin@your-domain.example
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
