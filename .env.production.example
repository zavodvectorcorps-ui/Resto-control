# Скопируйте в .env (именно так — docker compose подхватывает файл .env
# из корня проекта автоматически, без флагов) и заполните.

# Ваш реальный домен, например resto.mint-sport.by — без https:// и слэша.
# Должен указывать A-записью на IP этого VPS.
DOMAIN=your-domain.example

# Пароль root-пользователя MongoDB внутри docker-сети (наружу порт 27017
# не пробрасывается — база недоступна из интернета).
# Сгенерировать: openssl rand -hex 24
# Это же значение должно совпадать с паролем в backend/.env.production
# (в строке MONGO_URL).
MONGO_ROOT_PASSWORD=CHANGE_ME_SAME_AS_IN_BACKEND_ENV
