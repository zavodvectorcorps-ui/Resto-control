# Linux (systemd): автозапуск агента печати RestoControl
#
# 1) Отредактируйте пути ниже (ExecStart, WorkingDirectory) и User.
#    Узнать путь к node:  which node
# 2) Установка:
#      sudo cp restocontrol-agent.service /etc/systemd/system/
#      sudo systemctl daemon-reload
#      sudo systemctl enable --now restocontrol-agent
#    Статус / логи:
#      systemctl status restocontrol-agent
#      journalctl -u restocontrol-agent -f

[Unit]
Description=RestoControl Print Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ЗАМЕНИТЕ_пользователь
WorkingDirectory=/home/ЗАМЕНИТЕ/resto-agent
ExecStart=/usr/bin/node /home/ЗАМЕНИТЕ/resto-agent/agent.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
